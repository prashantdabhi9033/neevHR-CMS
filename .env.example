# Copy to .env and fill in. .env is gitignored.

# Postgres connection for Payload CMS (blog + leads)
DATABASE_URI="postgresql://user:password@localhost:5432/neevhr_cms"

# Long random string for Payload auth/session signing
PAYLOAD_SECRET="change-me-to-a-32-byte-random-hex"

# Public site origin (used by Payload admin + links)
NEXT_PUBLIC_SERVER_URL="http://localhost:3100"

# Google Analytics 4 measurement id (optional). Leave blank to disable.
# Create a property at https://analytics.google.com and paste the id here.
NEXT_PUBLIC_GA_ID=""

# Search Console verification tokens (optional)
NEXT_PUBLIC_GSC_VERIFICATION=""
NEXT_PUBLIC_BING_VERIFICATION=""

# Lead-notification email (optional). When set, a new demo request emails
# LEAD_NOTIFY_TO. For Google Workspace, SMTP_USER is a mailbox and SMTP_PASS
# is a Google App Password (needs 2-Step Verification on that account).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="hello@neevhr.com"
SMTP_PASS=""
LEAD_NOTIFY_TO="hello@neevhr.com"
